/* ---------------------------------------------------------------
   Viewer mode — someone opened a shared proposal link
--------------------------------------------------------------- */
async function renderViewer(token){
  document.getElementById('progress').style.display='none';
  let data = null;
  try{ data = decodePayload(token); }catch(e){ data = null; }
  if(!data){ data = await loadProposal(token); } // backward-compat: token might just be a bare id
  const id = (data && data.id) || token;
  if(!data){
    app().innerHTML = `
      <p class="eyebrow">SayIt</p>
      <h1 class="hero" style="font-size:26px;">This proposal wandered off</h1>
      <p class="sub">The link may be broken or expired. Ask them to resend it.</p>
      <button class="btn btn-primary" onclick="location.href=location.pathname">Create your own →</button>
    `;
    renderCat("Hmm, I couldn't find that one.");
    return;
  }
  const bg = currentBg(data.background);
  app().innerHTML = `
    <p class="eyebrow">A proposal for you</p>
    <div class="proposal-card" style="background-image:${bg.fallback};" id="previewCard">
      <img src="${bg.url}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-1;" onerror="this.style.display='none'"/>
      <div class="pc-content">
        <div class="pc-eyebrow">${esc(data.yourName)} → ${esc(data.theirName)}</div>
        <p class="pc-msg">${esc(data.message)}</p>
        <div class="pc-buttons" id="pcButtons" style="position:relative;">
          <button class="pc-btn yes" id="yesBtn">${esc(data.primaryLabel)}</button>
          <button class="pc-btn talk" id="talkBtn">${esc(data.secondaryLabel)}</button>
          ${data.dodgeNo ? `<button class="pc-btn no" id="dodgeBtn">No</button>` : ''}
        </div>
      </div>
    </div>
    <div id="responseArea"></div>
    <div class="footer-nav">
      <span></span>
      <button class="back-link" onclick="location.href=location.pathname">Make your own SayIt →</button>
    </div>
  `;
  state.showDodge = data.dodgeNo;
  wireDodge();
  document.getElementById('yesBtn').onclick = async ()=>{
    await recordResponse(id, data.primaryLabel);
    document.getElementById('responseArea').innerHTML = `
      <div class="response-screen"><div class="big">🎉</div><p class="sub">Sent — ${esc(data.yourName)} will be thrilled.</p></div>`;
    renderCat("Yes! I love a happy ending.");
  };
  document.getElementById('talkBtn').onclick = async ()=>{
    await recordResponse(id, data.secondaryLabel);
    document.getElementById('responseArea').innerHTML = `
      <div class="response-screen"><div class="big">💬</div><p class="sub">Noted — time for a real conversation.</p></div>`;
    renderCat("Smart. Words work best out loud sometimes.");
  };
  renderCat("Someone's waiting on your answer, no pressure.");
}

/* ---------------------------------------------------------------
   Boot
--------------------------------------------------------------- */
async function boot(){
  const hash = location.hash;
  const m = hash.match(/^#\/p\/(.+)$/);
  if(m){
    document.getElementById('cat-dock').style.display='flex';
    await renderViewer(m[1]);
    return;
  }
  await loadDraft();
  if(!state.step) state.step = 1;
  render();
}
boot();
