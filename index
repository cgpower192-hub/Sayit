}

/* Step 5 — share */
async function renderStep5(){
  app().innerHTML = `
    <p class="eyebrow">Step 5 of 5</p>
    <h1 class="hero" style="font-size:28px;">Ready to send</h1>
    <p class="sub">Publishing your proposal...</p>
