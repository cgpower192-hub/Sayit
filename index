<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SayIt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,560;0,9..144,650;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  :root{
    --bg-deep:#0a0c18;
    --bg-deep-2:#12142a;
    --glass:rgba(255,255,255,0.055);
    --glass-border:rgba(255,255,255,0.12);
    --ink:#f3f1ff;
    --ink-dim:#9ea3c9;
    --ink-dimmer:#6b709a;
    --accent-pink:#ff6fd8;
    --accent-violet:#8b7bff;
    --accent-mint:#34e4c1;
    --accent-gold:#ffc266;
    --grad-hero: linear-gradient(120deg,#ff6fd8 0%, #8b7bff 55%, #5a7dff 100%);
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
    --radius-lg:28px;
    --radius-md:18px;
    --radius-sm:12px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:var(--font-body);
    color:var(--ink);
    background:
      radial-gradient(ellipse 900px 600px at 15% -10%, rgba(139,123,255,0.35), transparent 60%),
      radial-gradient(ellipse 700px 500px at 110% 10%, rgba(255,111,216,0.22), transparent 60%),
      radial-gradient(ellipse 800px 700px at 50% 120%, rgba(52,228,193,0.14), transparent 60%),
      linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-deep-2) 100%);
    min-height:100vh;
    overflow-x:hidden;
    position:relative;
  }
  #particles{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
  .particle{
    position:absolute;bottom:-40px;opacity:0;font-size:14px;
    animation:floatUp linear forwards;
    filter:drop-shadow(0 0 6px rgba(255,111,216,0.5));
  }
  @keyframes floatUp{
    0%{transform:translateY(0) translateX(0) rotate(0deg) scale(0.6);opacity:0;}
    10%{opacity:0.85;}
    90%{opacity:0.6;}
    100%{transform:translateY(-110vh) translateX(var(--drift,20px)) rotate(180deg) scale(1);opacity:0;}
  }

  .wrap{
    position:relative;z-index:2;
    min-height:100vh;
    display:flex;flex-direction:column;align-items:center;
    padding:48px 20px 120px;
  }

  .brand{
    display:flex;align-items:center;gap:10px;margin-bottom:34px;
    font-family:var(--font-mono);letter-spacing:0.14em;font-size:12px;
    color:var(--ink-dim);text-transform:uppercase;
  }
  .brand .dot{width:7px;height:7px;border-radius:50%;background:var(--grad-hero);box-shadow:0 0 10px var(--accent-pink);}
  .brand b{color:var(--ink);font-family:var(--font-display);font-size:15px;font-weight:650;letter-spacing:0;text-transform:none;}

  .progress{
    display:flex;gap:6px;margin-bottom:30px;
  }
  .progress .seg{
    width:34px;height:4px;border-radius:3px;background:rgba(255,255,255,0.1);
    position:relative;overflow:hidden;transition:background .3s;
  }
  .progress .seg.done{background:var(--grad-hero);}
  .progress .seg.current{background:rgba(255,255,255,0.28);}

  .card{
    width:100%;max-width:560px;
    background:var(--glass);
    border:1px solid var(--glass-border);
    border-radius:var(--radius-lg);
    backdrop-filter:blur(22px) saturate(140%);
    -webkit-backdrop-filter:blur(22px) saturate(140%);
    box-shadow:0 30px 80px -20px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.08);
    padding:40px 36px 34px;
    animation:cardIn .5s cubic-bezier(.2,.8,.2,1);
  }
  @keyframes cardIn{from{opacity:0;transform:translateY(14px) scale(.98);}to{opacity:1;transform:none;}}

  .eyebrow{
    font-family:var(--font-mono);font-size:11px;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--ink-dimmer);margin:0 0 10px;
  }
  h1.hero{
    font-family:var(--font-display);font-weight:650;font-size:38px;line-height:1.08;
    margin:0 0 12px;
    background:var(--grad-hero);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .sub{color:var(--ink-dim);font-size:15px;line-height:1.5;margin:0 0 28px;}

  label.field-label{
    display:block;font-size:12px;color:var(--ink-dimmer);margin:0 0 7px;font-weight:500;letter-spacing:.02em;
  }
  .field{margin-bottom:18px;}
  input[type=text], textarea{
    width:100%;background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.12);
    border-radius:var(--radius-sm);
    padding:14px 16px;color:var(--ink);font-family:var(--font-body);font-size:15px;
    outline:none;transition:border-color .2s, background .2s, box-shadow .2s;
  }
  input[type=text]:focus, textarea:focus{
    border-color:var(--accent-violet);
    background:rgba(255,255,255,0.06);
    box-shadow:0 0 0 3px rgba(139,123,255,0.18);
  }
  textarea{resize:vertical;min-height:96px;line-height:1.5;font-family:var(--font-display);font-size:17px;}

  .btn{
    font-family:var(--font-body);font-weight:600;font-size:14.5px;
    border:none;border-radius:999px;padding:14px 26px;cursor:pointer;
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    transition:transform .18s cubic-bezier(.2,.8,.2,1), box-shadow .18s, filter .18s;
  }
  .btn:active{transform:scale(0.96);}
  .btn-primary{
    background:var(--grad-hero);color:#0a0c18;
    box-shadow:0 10px 30px -8px rgba(139,123,255,0.55);
  }
  .btn-primary:hover{transform:translateY(-2px) scale(1.015);box-shadow:0 14px 36px -8px rgba(139,123,255,0.7);}
  .btn-ghost{
    background:rgba(255,255,255,0.06);color:var(--ink);border:1px solid rgba(255,255,255,0.14);
  }
  .btn-ghost:hover{background:rgba(255,255,255,0.11);transform:translateY(-1px);}
  .btn:disabled{opacity:0.35;cursor:not-allowed;transform:none;box-shadow:none;}

  .row{display:flex;gap:12px;align-items:center;}
  .row.between{justify-content:space-between;}
  .footer-nav{display:flex;justify-content:space-between;align-items:center;margin-top:30px;}
  .back-link{color:var(--ink-dimmer);font-size:13.5px;cursor:pointer;background:none;border:none;font-family:var(--font-body);padding:8px 4px;}
  .back-link:hover{color:var(--ink-dim);}

  /* category cards */
  .cat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:8px;}
  .cat-card{
    background:rgba(255,255,255,0.035);border:1px solid rgba(255,255,255,0.1);
    border-radius:var(--radius-md);padding:20px 16px;cursor:pointer;text-align:left;
    transition:transform .2s cubic-bezier(.2,.8,.2,1), border-color .2s, background .2s;
  }
  .cat-card .icon{font-size:26px;display:block;margin-bottom:10px;transition:transform .25s;}
  .cat-card .name{font-family:var(--font-display);font-size:16px;font-weight:600;display:block;margin-bottom:3px;}
  .cat-card .desc{font-size:12px;color:var(--ink-dimmer);}
  .cat-card:hover{transform:translateY(-3px) scale(1.02);border-color:rgba(255,255,255,0.24);background:rgba(255,255,255,0.06);}
  .cat-card:hover .icon{transform:scale(1.18) rotate(-6deg);}
  .cat-card.selected{border-color:var(--accent-violet);background:rgba(139,123,255,0.12);box-shadow:0 0 0 1px var(--accent-violet), 0 10px 30px -10px rgba(139,123,255,0.5);}

  /* suggestion chips */
  .chip-grid{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;}
  .chip{
    font-size:13px;padding:9px 14px;border-radius:999px;
    background:rgba(255,255,255,0.045);border:1px solid rgba(255,255,255,0.12);
    color:var(--ink-dim);cursor:pointer;transition:all .18s;font-family:var(--font-body);
  }
  .chip:hover{background:rgba(255,255,255,0.09);color:var(--ink);border-color:rgba(255,255,255,0.25);transform:translateY(-1px);}
  .chip.picked{background:var(--grad-hero);color:#0a0c18;border-color:transparent;font-weight:600;}

  .char-count{text-align:right;font-size:11px;color:var(--ink-dimmer);margin-top:-12px;margin-bottom:16px;font-family:var(--font-mono);}

  /* bg gallery */
  .bg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:22px;}
  .bg-swatch{
    position:relative;aspect-ratio:1/1;border-radius:14px;overflow:hidden;cursor:pointer;
    border:2px solid transparent;background-size:cover;background-position:center;
    transition:transform .2s, border-color .2s;
  }
  .bg-swatch:hover{transform:scale(1.04);}
  .bg-swatch.selected{border-color:var(--accent-pink);box-shadow:0 0 0 1px var(--accent-pink);}
  .bg-swatch::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,0.55) 100%);}
  .bg-swatch span{position:absolute;bottom:6px;left:8px;font-size:10px;color:#fff;z-index:2;font-family:var(--font-mono);letter-spacing:.03em;}
  .bg-swatch .check{position:absolute;top:6px;right:6px;width:18px;height:18px;border-radius:50%;background:var(--accent-pink);color:#0a0c18;display:none;align-items:center;justify-content:center;font-size:11px;z-index:3;}
  .bg-swatch.selected .check{display:flex;}

  .toggle-row{display:flex;align-items:center;justify-content:space-between;padding:12px 4px;border-top:1px solid rgba(255,255,255,0.08);}
  .toggle-row:last-child{border-bottom:1px solid rgba(255,255,255,0.08);}
  .toggle-label{font-size:13.5px;color:var(--ink-dim);}
  .switch{width:38px;height:22px;border-radius:999px;background:rgba(255,255,255,0.14);position:relative;cursor:pointer;transition:background .2s;flex-shrink:0;}
  .switch.on{background:var(--grad-hero);}
  .switch::after{content:'';position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#fff;transition:transform .2s;}
  .switch.on::after{transform:translateX(16px);}

  /* preview card (shared render used in step4 preview + step5 + view mode) */
  .proposal-card{
    position:relative;border-radius:22px;overflow:hidden;padding:36px 26px;
    min-height:280px;display:flex;flex-direction:column;justify-content:flex-end;
    background-size:cover;background-position:center;
    box-shadow:0 20px 50px -15px rgba(0,0,0,0.6);
    isolation:isolate;
  }
  .proposal-card::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,24,0.15) 0%, rgba(10,12,24,0.88) 100%);z-index:0;}
  .proposal-card .pc-content{position:relative;z-index:1;}
  .pc-eyebrow{font-family:var(--font-mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,0.65);margin-bottom:10px;}
  .pc-msg{font-family:var(--font-display);font-size:24px;line-height:1.25;color:#fff;margin:0 0 20px;font-weight:560;}
  .pc-buttons{display:flex;gap:10px;position:relative;flex-wrap:wrap;}
  .pc-btn{padding:12px 22px;border-radius:999px;border:none;font-weight:650;font-size:14px;cursor:pointer;font-family:var(--font-body);}
  .pc-btn.yes{background:var(--grad-hero);color:#0a0c18;}
  .pc-btn.talk{background:rgba(255,255,255,0.14);color:#fff;border:1px solid rgba(255,255,255,0.3);}
  .pc-btn.no{background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);border:1px solid rgba(255,255,255,0.2);position:relative;transition:none;}
  .pc-btn.no.dodging{position:absolute;}

  /* share step */
  .share-actions{display:flex;flex-direction:column;gap:10px;margin-top:22px;}
  .share-row{display:flex;gap:10px;}
  .link-box{
    flex:1;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.14);
    border-radius:var(--radius-sm);padding:12px 14px;font-family:var(--font-mono);font-size:12px;
    color:var(--ink-dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .qr-wrap{display:flex;justify-content:center;padding:18px;background:#fff;border-radius:16px;margin-top:16px;}
  #qrcode{line-height:0;}

  /* cat mascot */
  #cat-dock{
    position:fixed;right:26px;bottom:22px;z-index:5;
    display:flex;align-items:flex-end;gap:0;
    max-width:calc(100vw - 40px);
  }
  .bubble{
    background:rgba(255,255,255,0.95);color:#1a1330;font-family:var(--font-body);
    font-size:13px;font-weight:500;line-height:1.35;
    padding:11px 15px;border-radius:16px 16px 4px 16px;
    max-width:190px;margin-right:-8px;margin-bottom:14px;
    box-shadow:0 12px 30px -8px rgba(0,0,0,0.5);
    animation:bubbleIn .35s cubic-bezier(.2,.8,.2,1);
    position:relative;
  }
  @keyframes bubbleIn{from{opacity:0;transform:translateY(6px) scale(.9);}to{opacity:1;transform:none;}}
  .cat-svg{width:78px;height:78px;filter:drop-shadow(0 10px 20px rgba(0,0,0,0.5));cursor:pointer;}
  .cat-blink{animation:blink 4.2s infinite;}
  @keyframes blink{0%,92%,100%{transform:scaleY(1);}94%{transform:scaleY(0.1);}96%{transform:scaleY(1);}}
  .cat-bob{animation:bob 3.4s ease-in-out infinite;}
  @keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}

  .draft-toast{
    position:fixed;left:50%;bottom:18px;transform:translateX(-50%) translateY(120%);
    background:rgba(18,20,42,0.92);border:1px solid rgba(255,255,255,0.14);
    color:var(--ink-dim);font-size:12.5px;padding:10px 18px;border-radius:999px;
    backdrop-filter:blur(10px);z-index:6;transition:transform .4s cubic-bezier(.2,.8,.2,1);
    display:flex;align-items:center;gap:8px;font-family:var(--font-body);
  }
  .draft-toast.show{transform:translateX(-50%) translateY(0);}
  .draft-toast .pulse{width:6px;height:6px;border-radius:50%;background:var(--accent-mint);box-shadow:0 0 8px var(--accent-mint);}

  .response-screen{text-align:center;padding:20px 0;}
  .response-screen .big{font-size:56px;margin-bottom:12px;}

  @media (max-width:600px){
    .card{padding:28px 22px 26px;border-radius:22px;}
    h1.hero{font-size:29px;}
    .cat-grid{grid-template-columns:1fr 1fr;}
    #cat-dock{right:14px;bottom:14px;}
    .cat-svg{width:60px;height:60px;}
    .bubble{max-width:150px;font-size:12px;padding:9px 12px;}
    .bg-grid{grid-template-columns:repeat(3,1fr);}
  }
</style>
</head>
<body>
<div id="particles"></div>
<div class="wrap">
  <div class="brand"><span class="dot"></span><b>SayIt</b></div>
  <div class="progress" id="progress"></div>
  <div class="card" id="app"></div>
</div>

<div id="cat-dock"></div>
<div class="draft-toast" id="draftToast"><span class="pulse"></span><span id="draftToastText">Draft saved</span></div>

<script>
/* ---------------------------------------------------------------
   SayIt — state
--------------------------------------------------------------- */
const BACKGROUNDS = [
  { id:'sunset', label:'Sunset', url:'https://images.unsplash.com/photo-1495616811223-4d98c6e9c869?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#ff9966,#ff6fd8)' },
  { id:'city', label:'City Night', url:'https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#141e30,#243b55)' },
  { id:'texture', label:'Marble', url:'https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#3a3a3a,#141414)' },
  { id:'cafe', label:'Cafe', url:'https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#6b4226,#3e2723)' },
  { id:'stars', label:'Night Sky', url:'https://images.unsplash.com/photo-1419242902214-272b3f66ee7a?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#0f2027,#2c5364)' },
  { id:'floral', label:'Floral', url:'https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=800&q=70', fallback:'linear-gradient(135deg,#8b7bff,#ff6fd8)' },
];

const CATEGORIES = {
  romantic: { label:'Romantic / Dating', icon:'❤️', desc:'Ask them out', accent:'var(--accent-pink)',
    suggestions:["Will you go out with me?","Coffee this weekend — my treat?","I've had a crush on you for a while. Dinner Friday?","Just the two of us, movie night?","Be my Valentine?","Let's make it official — will you be my partner?"],
    primaryLabel:'Yes!', secondaryLabel:"Let's talk", dodgeNo:true,
    catLines:["Ooh, matters of the heart. Let's get this right.","Sweet — I'll help you pick the words.","Bold move. I like it."]},
  business: { label:'Business / Deal Pitch', icon:'💼', desc:'Pitch or propose', accent:'var(--accent-mint)',
    suggestions:["Let's collaborate on this project.","I'd like to propose a partnership.","Can we set up a call to discuss terms?","Here's my pitch — want to hear more?","Let's close this deal.","Open to a joint venture?"],
    primaryLabel:"I'm in", secondaryLabel:"Let's talk", dodgeNo:false,
    catLines:["Sharp pitch. Keep it clear and confident.","Straight to business, I respect it.","Numbers or no numbers, make it count."]},
  social: { label:'Social / Hangout / Favor', icon:'🎉', desc:'Plans, favors, fun', accent:'var(--accent-violet)',
    suggestions:["Road trip this weekend?","Can you help me move on Saturday?","Game night at mine?","Want to grab dinner with the crew?","Could you cover my shift?","Beach day — you in?"],
    primaryLabel:"I'm in!", secondaryLabel:'Maybe', dodgeNo:false,
    catLines:["Low stakes, high fun. Love it.","Easy ask, easy yes — probably.","Casual is my favorite setting."]},
  playful: { label:'Playful / Custom', icon:'🃏', desc:'Anything goes', accent:'var(--accent-gold)',
    suggestions:["I dare you to say yes.","This is a very serious proposal (it is not).","Will you accept this extremely important mission?","Say yes and I'll owe you one.","Choose wisely...","Write your own — surprise me."],
    primaryLabel:"Absolutely", secondaryLabel:"Tell me more", dodgeNo:true,
    catLines:["Ooh, mischief. I like where this is going.","No rules here. Go wild.","Whatever you write, I'm purring for it."]},
};

const DEFAULT_STATE = {
  step:1, yourName:'', theirName:'', category:null, message:'',
  background: BACKGROUNDS[0].id, showDodge:false,
  primaryLabel:'', secondaryLabel:'',
};

let state = { ...DEFAULT_STATE };
let draftSaveTimer = null;

/* ---------------------------------------------------------------
   Storage adapter — uses Claude's window.storage inside Claude
   artifacts, falls back to real localStorage when this file is
   hosted anywhere else (Netlify, GitHub Pages, etc).
--------------------------------------------------------------- */
const hasClaudeStorage = (typeof window !== 'undefined') && window.storage && typeof window.storage.set === 'function';

async function storageSet(key, value, shared){
  if(hasClaudeStorage){
    try{ return await window.storage.set(key, value, shared); }catch(e){ /* fall through */ }
  }
  try{ localStorage.setItem((shared?'shared:':'personal:')+key, value); return {key,value,shared}; }
  catch(e){ return null; }
}
async function storageGet(key, shared){
  if(hasClaudeStorage){
    try{ return await window.storage.get(key, shared); }catch(e){ return null; }
  }
  try{
    const v = localStorage.getItem((shared?'shared:':'personal:')+key);
    return v!=null ? {key,value:v,shared} : null;
  }catch(e){ return null; }
}

async function saveDraft(){
  try{
    await storageSet('sayit:draft', JSON.stringify(state), false);
    showDraftToast('Draft saved');
  }catch(e){ /* silent */ }
}
async function loadDraft(){
  try{
    const r = await storageGet('sayit:draft', false);
    if(r && r.value){
      const parsed = JSON.parse(r.value);
      state = { ...DEFAULT_STATE, ...parsed };
    }
  }catch(e){ /* no draft yet */ }
}
function queueSave(){
  clearTimeout(draftSaveTimer);
  draftSaveTimer = setTimeout(saveDraft, 500);
}
let toastTimer=null;
function showDraftToast(text){
  const t = document.getElementById('draftToast');
  document.getElementById('draftToastText').textContent = text;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 1800);
}

function genId(){
  return Math.random().toString(36).slice(2,8) + Date.now().toString(36).slice(-4);
}

/* Proposal data is embedded directly in the share link (base64url in the
   hash) so a recipient can open it the instant the artifact is published —
   no dependency on shared storage having synced yet. We still write a copy
   to shared storage as a backup lookup path and to record responses. */
function encodePayload(obj){
  const json = JSON.stringify(obj);
  const b64 = btoa(unescape(encodeURIComponent(json)));
  return b64.replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
}
function decodePayload(str){
  let s = str.replace(/-/g,'+').replace(/_/g,'/');
  while(s.length % 4) s += '=';
  const json = decodeURIComponent(escape(atob(s)));
  return JSON.parse(json);
}

async function publishProposal(){
  const id = genId();
  const cat = CATEGORIES[state.category] || CATEGORIES.playful;
  const payload = {
    id, yourName:state.yourName, theirName:state.theirName, category:state.category,
    message:state.message, background:state.background,
    primaryLabel: state.primaryLabel || cat.primaryLabel,
    secondaryLabel: state.secondaryLabel || cat.secondaryLabel,
    dodgeNo: state.showDodge,
    createdAt: Date.now(),
  };
  try{ await storageSet('proposal:'+id, JSON.stringify(payload), true); }catch(e){ /* non-fatal, link still self-contained */ }
  const token = encodePayload(payload);
  return { id, token };
}

async function loadProposal(id){
  try{
    const r = await storageGet('proposal:'+id, true);
    return r && r.value ? JSON.parse(r.value) : null;
  }catch(e){ return null; }
}

async function recordResponse(id, answer){
  try{
    await storageSet('response:'+id, JSON.stringify({answer, at:Date.now()}), true);
  }catch(e){}
}

