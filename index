/* ---------------------------------------------------------------
   Rendering
--------------------------------------------------------------- */
const STEP_LABELS = ['Start','Category','Message','Design','Share'];

function renderProgress(){
  const el = document.getElementById('progress');
  const totalSteps = 5;
  el.innerHTML = STEP_LABELS.map((_,i)=>{
    const n=i+1;
    let cls='seg';
    if(n < state.step) cls+=' done';
    else if(n===state.step) cls+=' current';
    return `<div class="${cls}"></div>`;
  }).join('');
}

function esc(s){
  return (s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function currentBg(id){
  return BACKGROUNDS.find(b=>b.id===id) || BACKGROUNDS[0];
}

function app(){ return document.getElementById('app'); }

function goStep(n){
  state.step = n;
  render();
  queueSave();
  window.scrollTo({top:0, behavior:'smooth'});
}

function render(){
  renderProgress();
  renderCat(catLineFor());
  if(state.step===1) return renderStep1();
  if(state.step===2) return renderStep2();
  if(state.step===3) return renderStep3();
  if(state.step===4) return renderStep4();
  if(state.step===5) return renderStep5();
}

