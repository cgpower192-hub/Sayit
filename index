          ${state.showDodge ? `<button class="pc-btn no" id="dodgeBtn">No</button>` : ''}
        </div>
      </div>
    </div>
  `;
}
function wireDodge(){
  const btn = document.getElementById('dodgeBtn');
  const container = document.getElementById('pcButtons');
  if(!btn || !container) return;
  const dodge = ()=>{
    const cw = container.clientWidth, ch = container.clientHeight;
    const bw = btn.offsetWidth, bh = btn.offsetHeight;
    const maxX = Math.max(cw-bw, 40), maxY = Math.max(ch-bh, 20);
    const x = Math.random()*maxX, y = Math.random()*(maxY+30)-10;
    btn.classList.add('dodging');
    btn.style.left = x+'px';
    btn.style.top = y+'px';
  };
  btn.addEventListener('mouseenter', dodge);
  btn.addEventListener('touchstart', (e)=>{e.preventDefault(); dodge();}, {passive:false});
}

